// T3 — CPCL-dialect chassis: CPCL text (`! 0 200 200 …`, PAGE-WIDTH,
// ZG, PRINT) inside a binary envelope, with a zlib raster behind a
// 4-byte big-endian length. It does not speak TSPL; on the old
// marklife-tspl binding it would never have printed.
//
// dpi 200, headDots 576, compression zlib and the engine binding all
// come from our own wire analysis. NONE of it is bench-confirmed — no
// CPCL chassis has ever been tested.
{
  key: 'T3',
  name: 'T3',
  family: 'marklife',
  transports: {
    'bluetooth-spp': { namePrefix: 'T3' },
  'bluetooth-gatt': {
    // Profile A is the family's primary GATT profile. The chassis
    // does NOT advertise it — the advertisement carries only a
    // vendor UUID (observed over the air with a BlueZ LE scan,
    // 2026-09-10) — so the picker must filter on the name and the
    // driver resolves the profile after connecting. marklife-web
    // probes A, then the Microchip transparent-UART profile, then
    // Profile C; see web/src/ble-profiles.ts.
    serviceUuid: '0000ff00-0000-1000-8000-00805f9b34fb',
    txCharacteristicUuid: '0000ff02-0000-1000-8000-00805f9b34fb',
    rxCharacteristicUuid: '0000ff01-0000-1000-8000-00805f9b34fb',
    // BLE advertises as the SPP name plus a `_BLE` suffix
    // (`P12_ZA15B` / `P12_ZA15B_BLE`), so the SPP prefix matches both.
    namePrefix: 'T3',
  },
  },
  engines: [
    {
      role: 'primary',
      protocol: 'marklife-cpcl',
      // The CPCL preamble declares 200 dpi on both axes, not the 203
      // the rest of the family runs.
      dpi: 200,
      // PAGE-WIDTH and the coordinate clamp both top out at 576.
      headDots: 576,
      capabilities: {
        bitPolarity: '1=dark',
        // ZG payload is deflate, same 1 KiB window as the YXQ raster.
        compression: 'zlib',
        protocolId: 0,
        physicalSizeClass: 2.0,
        realSeries: 'T3',
        bleProfile: null,
      },
    },
  ],
  hardwareQuirks:
    'CPCL dialect over a binary envelope, per our own wire analysis — unverified, no CPCL chassis has been bench-tested. dpi 200, headDots 576 and the zlib raster all need a capture to confirm.',
  support: { status: 'untested' },
}
