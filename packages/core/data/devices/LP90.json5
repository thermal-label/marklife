// LP90 — L11 binary protocol (protocol id 11). 90mm-wide
// hint per the model name.
//
// Rebound marklife-escpos → marklife-l11 per the reconciliation
// against thermoprint § 5 (DECISIONS.md § D5). thermoprint
// explicitly groups LP90 with the P12 family: §3.1 lists LP90 under
// protocol #11, §5 row "LP90" = L11 `p112Print`, and `p12.ts`
// `namePrefixes` includes "LP90". Standard L11 density (`1F 70 02
// DD`) — `p12.ts` carries no `densityCommand` override, so this is
// not the P15-family thickness variant. The prior `marklife-escpos`
// binding has no thermoprint counterpart and cannot drive an L11
// raw-raster head. headDots stays the existing derived best-guess
// pending a capture.
{
  key: 'LP90',
  name: 'LP90',
  family: 'marklife',
  transports: {
    'bluetooth-spp': { namePrefix: 'LP90' },
  'bluetooth-gatt': {
    // Profile A is the family's primary GATT profile. The chassis
    // does NOT advertise it — the advertisement carries only a
    // vendor UUID (observed over the air with a BlueZ LE scan,
    // 2026-09-10) — so the picker must filter on the name and the
    // driver resolves the profile after connecting. marklife-web
    // probes A, then the Microchip transparent-UART profile, then
    // Profile C; see web/src/ble-profiles.ts.
    serviceUuid: '0000ff00-0000-1000-8000-00805f9b34fb',
    txCharacteristicUuid: '0000ff02-0000-1000-8000-00805f9b34fb',
    rxCharacteristicUuid: '0000ff01-0000-1000-8000-00805f9b34fb',
    // BLE advertises as the SPP name plus a `_BLE` suffix
    // (`P12_ZA15B` / `P12_ZA15B_BLE`), so the SPP prefix matches both.
    namePrefix: 'LP90',
    // Vendor caps this family at 90 bytes per BLE packet
    // regardless of the negotiated MTU. Bench-confirmed on the S2
    // 2026-09-11: a job sent in 95-byte packets prints, the same
    // job in 176-byte packets (MTU 179 minus the ATT header) does
    // not. Treated as a hard ceiling, never raised by negotiation.
    mtu: 90,
  },
  },
  engines: [
    {
      role: 'primary',
      protocol: 'marklife-l11',
      dpi: 203,
      headDots: 720, // 8 dots/mm × 90 mm — derived best-guess, TODO confirm via capture
      capabilities: {
        bitPolarity: '1=dark',
        compression: 'none', // L11 sends a raw uncompressed GS v 0 raster
        protocolId: 11, // L11 — thermoprint § 3.1 lists it as id 11
        physicalSizeClass: 3.0,
        realSeries: 'LP90',
        bleProfile: null,
      },
    },
  ],
  support: { status: 'untested' },
}
