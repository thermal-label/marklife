// X8 — 4"-industrial chassis, protocol id 10.
//
// ⚠️  Id 10 is NOT the id-7/id-12 wire protocol, despite sharing the
//     marklife-jbig tag: a different config block, a banded raster
//     with its own headers and terminator. encodeJbigJob hard-rejects
//     id 10 rather than emitting an id-12-shaped job that would print
//     nothing. Inference only — no id-10 chassis has been on the bench
//     and there is no capture.
//
// ⚠️  unsupported — needs its own encoder on top of the deferred JBIG
//     payload encoder (DECISIONS.md § D4).
{
  key: 'X8',
  name: 'X8',
  family: 'marklife',
  transports: {
    'bluetooth-spp': { namePrefix: 'X8' },
  'bluetooth-gatt': {
    // Profile A is the family's primary GATT profile. The chassis
    // does NOT advertise it — the advertisement carries only a
    // vendor UUID (observed over the air with a BlueZ LE scan,
    // 2026-09-10) — so the picker must filter on the name and the
    // driver resolves the profile after connecting. marklife-web
    // probes A, then the Microchip transparent-UART profile, then
    // Profile C; see web/src/ble-profiles.ts.
    serviceUuid: '0000ff00-0000-1000-8000-00805f9b34fb',
    txCharacteristicUuid: '0000ff02-0000-1000-8000-00805f9b34fb',
    rxCharacteristicUuid: '0000ff01-0000-1000-8000-00805f9b34fb',
    // BLE advertises as the SPP name plus a `_BLE` suffix
    // (`P12_ZA15B` / `P12_ZA15B_BLE`), so the SPP prefix matches both.
    namePrefix: 'X8',
  },
  },
  engines: [
    {
      role: 'primary',
      protocol: 'marklife-jbig',
      dpi: 203,
      headDots: 832,
      capabilities: {
        bitPolarity: '1=dark',
        compression: 'jbig',
        protocolId: 10,
        physicalSizeClass: 4.0,
        realSeries: 'X8',
        bleProfile: null,
      },
    },
  ],
  verifications: {
    'bluetooth-spp': {
      status: 'unsupported',
      reason: 'protocol id 10 has no encoder — rejected by encodeJbigJob; needs its own encoder + paced multi-write transport',
    },
  },
  support: {
    status: 'broken',
    quirks: 'Protocol id 10 is a different wire protocol from the id-7/id-12 marklife-jbig job (1F FD 01 A5 config, 100-row bands with 1F 01 05 A5 headers in 512-byte pieces, 1F 01 06 A5 terminator). encodeJbigJob rejects it; it needs its own encoder and a transport that can pace the writes, plus the deferred JBIG payload encoder (DECISIONS.md § D4).',
  },
}
