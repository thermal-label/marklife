// BARABOGO P12 — L11 binary protocol P12 chassis whitelabel.
//
// Rebound marklife-yxq → marklife-l11 per the reconciliation
// against thermoprint § 5 (DECISIONS.md § D5). This is a
// literal P12-hardware whitelabel (`realSeries: P12`); thermoprint §5
// maps P12 → L11 (#11) `p112Print` and `p12.ts` is standard-density
// (no `densityCommand` override → `1F 70 02 DD`, not the P15-family
// thickness variant). The prior `protocolId: 4` was the same mis-read
// as the original P12 bug (see DECISIONS.md §D5). headDots set to 96
// — the bench-confirmed P12 head width (12 bytes/row).
{
  key: 'BARABOGOP12',
  name: 'BARABOGOP12',
  family: 'marklife',
  transports: {
    'bluetooth-spp': { namePrefix: 'BARABOGOP12' },
  'bluetooth-gatt': {
    // Profile A is the family's primary GATT profile. The chassis
    // does NOT advertise it — the advertisement carries only a
    // vendor UUID (observed over the air with a BlueZ LE scan,
    // 2026-09-10) — so the picker must filter on the name and the
    // driver resolves the profile after connecting. marklife-web
    // probes A, then the Microchip transparent-UART profile, then
    // Profile C; see web/src/ble-profiles.ts.
    serviceUuid: '0000ff00-0000-1000-8000-00805f9b34fb',
    txCharacteristicUuid: '0000ff02-0000-1000-8000-00805f9b34fb',
    rxCharacteristicUuid: '0000ff01-0000-1000-8000-00805f9b34fb',
    // BLE advertises as the SPP name plus a `_BLE` suffix
    // (`P12_ZA15B` / `P12_ZA15B_BLE`), so the SPP prefix matches both.
    namePrefix: 'BARABOGOP12',
  },
  },
  engines: [
    {
      role: 'primary',
      protocol: 'marklife-l11',
      dpi: 203,
      headDots: 96, // P12-hardware whitelabel — bench-confirmed P12 head width
      capabilities: {
        bitPolarity: '1=dark',
        compression: 'none', // L11 sends a raw uncompressed GS v 0 raster
        protocolId: 11, // L11 — thermoprint § 3.1 lists it as id 11
        physicalSizeClass: 0.5,
        realSeries: 'P12',
        bleProfile: null,
      },
    },
  ],
  hardwareQuirks: 'BARABOGO whitelabel of YXQ P12; same hardware, different display name.',
  support: { status: 'untested' },
}
