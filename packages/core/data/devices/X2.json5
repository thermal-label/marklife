// X2 — YXQ-stream proprietary (protocol id 9). 2" mobile.
// Classic-BT SPP variant of the X2 chassis. Same hardware as X2_BLE
// but reached over RFCOMM/SPP instead of BLE Profile C.
//
// id 9 does not raster like the rest of the YXQ family: it sends
// `1D 76 30 …` plus raw 1-bpp rows, with no zlib envelope — hence
// `compression: 'none'` below.
//
// Known discovery ambiguity: `namePrefix: 'X2'` would also match a
// Pro variant of the chassis, which may raster differently. We have
// no capture of one, so there is no separate entry.
{
  key: 'X2',
  name: 'X2',
  family: 'marklife',
  transports: {
    'bluetooth-spp': { namePrefix: 'X2' },
  'bluetooth-gatt': {
    // Profile A is the family's primary GATT profile. The chassis
    // does NOT advertise it — the advertisement carries only a
    // vendor UUID (observed over the air with a BlueZ LE scan,
    // 2026-09-10) — so the picker must filter on the name and the
    // driver resolves the profile after connecting. marklife-web
    // probes A, then the Microchip transparent-UART profile, then
    // Profile C; see web/src/ble-profiles.ts.
    serviceUuid: '0000ff00-0000-1000-8000-00805f9b34fb',
    txCharacteristicUuid: '0000ff02-0000-1000-8000-00805f9b34fb',
    rxCharacteristicUuid: '0000ff01-0000-1000-8000-00805f9b34fb',
    // BLE advertises as the SPP name plus a `_BLE` suffix
    // (`P12_ZA15B` / `P12_ZA15B_BLE`), so the SPP prefix matches both.
    namePrefix: 'X2',
  },
  },
  engines: [
    {
      role: 'primary',
      protocol: 'marklife-yxq',
      dpi: 203,
      headDots: 384, // best-guess for 2" class — TODO confirm against datasheet
      capabilities: {
        bitPolarity: '1=dark',
        compression: 'none', // id 9 sends a raw raster — see the header note
        protocolId: 9,
        physicalSizeClass: 2.0,
        realSeries: 'X2',
        bleProfile: null,
        // The X2 chassis drains its intake at 1 ms per packet, not the
        // family's 30 (thermoprint § 2.5 timer table); unbenched.
        interChunkDelayMs: 1,
        // The X2 family is sold with red+black stock. Informational
        // only: the encoder emits the black plane and nothing else, so
        // a red+black job prints monochrome rather than failing.
        redBlackDuplex: true,
      },
    },
  ],
  support: { status: 'untested' },
}
