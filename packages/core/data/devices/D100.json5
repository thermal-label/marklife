// D100 — JBIG-via-ESC/POS-dialect (protocol id 12).
// Classic-Bluetooth SPP. Job shape: print speed first, then per-copy
// density, GS L, GS W 864, ESC a, paper-type-gated feed markers
// around the 1F ( J raster block, then the trailer.
//
// ⚠️  support.status: 'broken' — JBIG payload encoder is deferred
//     (DECISIONS.md § D4); it needs a WASM build of libjbigkit, and
//     marklife-jbig throws UnsupportedOperationError at print time.
//     The id-12 wrapper around it is complete but unverified — no
//     chassis on this protocol has ever been on the bench.
{
  key: 'D100',
  name: 'D100',
  family: 'marklife',
  transports: {
    'bluetooth-spp': { namePrefix: 'D100' },
  'bluetooth-gatt': {
    // Profile A is the family's primary GATT profile. The chassis
    // does NOT advertise it — the advertisement carries only a
    // vendor UUID (observed over the air with a BlueZ LE scan,
    // 2026-09-10) — so the picker must filter on the name and the
    // driver resolves the profile after connecting. marklife-web
    // probes A, then the Microchip transparent-UART profile, then
    // Profile C; see web/src/ble-profiles.ts.
    serviceUuid: '0000ff00-0000-1000-8000-00805f9b34fb',
    txCharacteristicUuid: '0000ff02-0000-1000-8000-00805f9b34fb',
    rxCharacteristicUuid: '0000ff01-0000-1000-8000-00805f9b34fb',
    // BLE advertises as the SPP name plus a `_BLE` suffix
    // (`P12_ZA15B` / `P12_ZA15B_BLE`), so the SPP prefix matches both.
    namePrefix: 'D100',
  },
  },
  engines: [
    {
      role: 'primary',
      protocol: 'marklife-jbig',
      dpi: 203,
      headDots: 384, // best-guess; D100 is portable-class — TODO confirm against datasheet
      capabilities: {
        bitPolarity: '1=dark',
        compression: 'jbig',
        protocolId: 12,
        physicalSizeClass: 2.0,
        realSeries: 'D100',
        bleProfile: null,
      },
    },
  ],
  verifications: {
    'bluetooth-spp': {
      status: 'unsupported',
      reason: 'JBIG encoder deferred (DECISIONS.md § D4)',
    },
  },
  support: {
    status: 'broken',
    quirks: 'JBIG payload encoder deferred — see DECISIONS.md § D4; the encoder throws UnsupportedOperationError today. The id-12 wrapper (speed first, per-copy density, GS L, GS W 864, feed markers, 1F ( J) is implemented but unverified — no bench unit. Lifts to "untested" once a WASM build of libjbigkit ships.',
  },
}
