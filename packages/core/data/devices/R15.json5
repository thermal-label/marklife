// R15 — L11 binary protocol (protocol id 11). 0.5" narrow
// tape. Classic-BT SPP.
//
// Rebound marklife-yxq → marklife-l11 per the reconciliation
// against thermoprint § 5 (DECISIONS.md § D5). thermoprint
// §3.1 names protocol #11 `R15Protocol` — the L11 raw-raster binary
// protocol; the registry already declared `protocolId: 11`, so the
// prior `marklife-yxq` (compressed) binding was internally
// contradictory (the same class of mis-read as the original P12 bug;
// see DECISIONS.md §D5). R15 is not in any thermoprint device
// profile, so the L11 binding rests on `protocolId: 11` + the
// `R15Protocol` class name rather than a thermoprint namePrefix
// match. Standard L11 density (`1F 70 02 DD`) — not the P15-family
// thickness variant. headDots stays a best-guess pending a capture.
{
  key: 'R15',
  name: 'R15',
  family: 'marklife',
  transports: {
    'bluetooth-spp': { namePrefix: 'R15' },
  'bluetooth-gatt': {
    // Profile A is the family's primary GATT profile. The chassis
    // does NOT advertise it — the advertisement carries only a
    // vendor UUID (observed over the air with a BlueZ LE scan,
    // 2026-09-10) — so the picker must filter on the name and the
    // driver resolves the profile after connecting. marklife-web
    // probes A, then the Microchip transparent-UART profile, then
    // Profile C; see web/src/ble-profiles.ts.
    serviceUuid: '0000ff00-0000-1000-8000-00805f9b34fb',
    txCharacteristicUuid: '0000ff02-0000-1000-8000-00805f9b34fb',
    rxCharacteristicUuid: '0000ff01-0000-1000-8000-00805f9b34fb',
    // BLE advertises as the SPP name plus a `_BLE` suffix
    // (`P12_ZA15B` / `P12_ZA15B_BLE`), so the SPP prefix matches both.
    namePrefix: 'R15',
  },
  },
  engines: [
    {
      role: 'primary',
      protocol: 'marklife-l11',
      dpi: 203,
      headDots: 100, // best-guess for 0.5" class — TODO confirm against datasheet
      capabilities: {
        bitPolarity: '1=dark',
        compression: 'none', // L11 sends a raw uncompressed GS v 0 raster
        protocolId: 11, // L11 — thermoprint § 3.1 lists it as id 11
        physicalSizeClass: 0.5,
        realSeries: 'R15',
        bleProfile: null,
      },
    },
  ],
  support: { status: 'untested' },
}
