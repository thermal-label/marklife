// X4 — JBIG-via-ESC/POS-dialect (protocol id 7).
// Receipt-style 2"-class chassis.
//
// Id 7 is not id 12 with different constants: first-copy paper-type
// prelude + density, print speed inside each copy's header, GS W 800,
// no GS L, unconditional pre-raster feed marker.
//
// ⚠️  support.status: 'broken' — JBIG payload encoder deferred
//     (DECISIONS.md § D4). Wrapper unverified — no bench unit.
{
  key: 'X4',
  name: 'X4',
  family: 'marklife',
  transports: {
    'bluetooth-spp': { namePrefix: 'X4' },
  'bluetooth-gatt': {
    // Profile A is the family's primary GATT profile. The chassis
    // does NOT advertise it — the advertisement carries only a
    // vendor UUID (observed over the air with a BlueZ LE scan,
    // 2026-09-10) — so the picker must filter on the name and the
    // driver resolves the profile after connecting. marklife-web
    // probes A, then the Microchip transparent-UART profile, then
    // Profile C; see web/src/ble-profiles.ts.
    serviceUuid: '0000ff00-0000-1000-8000-00805f9b34fb',
    txCharacteristicUuid: '0000ff02-0000-1000-8000-00805f9b34fb',
    rxCharacteristicUuid: '0000ff01-0000-1000-8000-00805f9b34fb',
    // BLE advertises as the SPP name plus a `_BLE` suffix
    // (`P12_ZA15B` / `P12_ZA15B_BLE`), so the SPP prefix matches both.
    namePrefix: 'X4',
  },
  },
  engines: [
    {
      role: 'primary',
      protocol: 'marklife-jbig',
      dpi: 203,
      headDots: 384,
      capabilities: {
        bitPolarity: '1=dark',
        compression: 'jbig',
        protocolId: 7,
        physicalSizeClass: 2.0,
        realSeries: 'X4',
        bleProfile: null,
      },
    },
  ],
  verifications: {
    'bluetooth-spp': {
      status: 'unsupported',
      reason: 'JBIG encoder deferred (DECISIONS.md § D4)',
    },
  },
  support: {
    status: 'broken',
    quirks: 'JBIG payload encoder deferred — see DECISIONS.md § D4. The id-7 wrapper (paper-type prelude, first-copy density, print speed, GS W 800, no GS L, feed markers, 1F ( J) is implemented but unverified — no chassis on this protocol has been on the bench.',
  },
}
