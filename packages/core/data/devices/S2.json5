// S2 — YXQ-stream proprietary (protocol id 2). 2" mobile.
// Classic-BT SPP plus BLE; the USB port is charge-only (nothing
// enumerates, bench 2026-09-13). A GATT probe of a real unit (2026-09-11)
// found it hosting Profile A (ff00), the Microchip transparent UART
// and the generic 18f0 printer service side by side, so the driver
// probes rather than trusting a per-model profile.
//
// Bench-verified 2026-09-11 over BLE: prints a multi-packet raster.
// It is the reference chassis for the whole marklife-yxq binding —
// getting it printing corrected the command prefix, the page advance,
// the deflate window, the packet ceiling and the send pacing.
{
  key: 'S2',
  name: 'S2',
  family: 'marklife',
  transports: {
    'bluetooth-spp': { namePrefix: 'S2' },
  'bluetooth-gatt': {
    // Profile A is the family's primary GATT profile. The chassis
    // does NOT advertise it — the advertisement carries only a
    // vendor UUID (observed over the air with a BlueZ LE scan,
    // 2026-09-10) — so the picker must filter on the name and the
    // driver resolves the profile after connecting. marklife-web
    // probes A, then the Microchip transparent-UART profile, then
    // Profile C; see web/src/ble-profiles.ts.
    serviceUuid: '0000ff00-0000-1000-8000-00805f9b34fb',
    txCharacteristicUuid: '0000ff02-0000-1000-8000-00805f9b34fb',
    rxCharacteristicUuid: '0000ff01-0000-1000-8000-00805f9b34fb',
    // BLE advertises as the SPP name plus a `_BLE` suffix
    // (`P12_ZA15B` / `P12_ZA15B_BLE`), so the SPP prefix matches both.
    namePrefix: 'S2',
    // Vendor caps this family at 95 bytes per BLE packet
    // regardless of the negotiated MTU. Bench-confirmed on the S2
    // 2026-09-11: a job sent in 95-byte packets prints, the same
    // job in 176-byte packets (MTU 179 minus the ATT header) does
    // not. Treated as a hard ceiling, never raised by negotiation.
    mtu: 95,
  },
  },
  engines: [
    {
      role: 'primary',
      protocol: 'marklife-yxq',
      dpi: 203,
      headDots: 384, // 48 bytes/row in every captured S2 job
      capabilities: {
        bitPolarity: '1=dark',
        compression: 'zlib',
        protocolId: 2,
        physicalSizeClass: 2.0,
        realSeries: 'S2',
        bleProfile: null,
      },
    },
  ],
  support: { status: 'verified' },
  verifications: {
    // Maintainer's own bench — multi-packet raster prints over BLE
    // and SPP through the harness. Classic pairing needs no PIN.
    'bluetooth-gatt': { status: 'verified', lastReported: '2026-09-13' },
    'bluetooth-spp': { status: 'verified', lastReported: '2026-09-13' },
  },
}
