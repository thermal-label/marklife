// P15 — L11 binary protocol (protocol id 11). Narrow-tape
// ~0.5" class. USB Printer-class (5958:0015) + Classic-BT SPP.
//
// Rebound from marklife-tspl: thermoprint makes the P15 its reference
// L11 device (REVERSE_ENGINEERING.md § 3.2). `headDots` is assumed 96
// — the same as the bench-confirmed P12 — because thermoprint's p12
// and p15 profiles carry identical label-size presets (shared tape
// stock, hence the same head). Confirm with a P15 capture/bench print.
//
// Note: thermoprint's p15 profile uses the L11 `thickness` density
// command (`10 FF 10 00 TT`), not the standard `1F 70 02 DD`. The
// marklife-l11 encoder emits density opt-in only and the diagnostic
// path sends none — so this rebind is sound for the no-density path.
// Explicit-density P15 jobs need the thickness variant — DECISIONS.md
// § D5.
{
  key: 'P15',
  name: 'P15',
  family: 'marklife',
  transports: {
    usb: { vid: '0x5958', pid: '0x0015' },
    'bluetooth-spp': { namePrefix: 'P15' },
  'bluetooth-gatt': {
    // Profile A is the family's primary GATT profile. The chassis
    // does NOT advertise it — the advertisement carries only a
    // vendor UUID (observed over the air with a BlueZ LE scan,
    // 2026-09-10) — so the picker must filter on the name and the
    // driver resolves the profile after connecting. marklife-web
    // probes A, then the Microchip transparent-UART profile, then
    // Profile C; see web/src/ble-profiles.ts.
    serviceUuid: '0000ff00-0000-1000-8000-00805f9b34fb',
    txCharacteristicUuid: '0000ff02-0000-1000-8000-00805f9b34fb',
    rxCharacteristicUuid: '0000ff01-0000-1000-8000-00805f9b34fb',
    // BLE advertises as the SPP name plus a `_BLE` suffix
    // (`P12_ZA15B` / `P12_ZA15B_BLE`), so the SPP prefix matches both.
    namePrefix: 'P15',
    // Vendor caps this family at 95 bytes per BLE packet
    // regardless of the negotiated MTU. Bench-confirmed on the S2
    // 2026-09-11: a job sent in 95-byte packets prints, the same
    // job in 176-byte packets (MTU 179 minus the ATT header) does
    // not. Treated as a hard ceiling, never raised by negotiation.
    mtu: 95,
  },
  },
  engines: [
    {
      role: 'primary',
      protocol: 'marklife-l11',
      dpi: 203,
      headDots: 96, // assumed same as the P12 (shared tape stock) — confirm by capture/bench
      capabilities: {
        bitPolarity: '1=dark',
        compression: 'none', // L11 sends a raw uncompressed GS v 0 raster
        protocolId: 11, // L11 — thermoprint § 3.1 lists it as id 11
        physicalSizeClass: 0.5,
        realSeries: 'P15',
        bleProfile: null,
      },
    },
  ],
  support: { status: 'verified' },
  verifications: {
    // Maintainer's own bench — prints through the harness over BLE,
    // USB and SPP. Classic pairing PIN 1234.
    'bluetooth-gatt': { status: 'verified', lastReported: '2026-09-13' },
    usb: { status: 'verified', lastReported: '2026-09-13' },
    'bluetooth-spp': { status: 'verified', lastReported: '2026-09-13' },
  },
}
